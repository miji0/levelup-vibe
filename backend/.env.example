APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://levelup:levelup@localhost:5432/levelup
OWNER_GOOGLE_SUB=replace-with-your-google-sub
OWNER_EMAIL=you@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64 encoded 32 random bytes. Generate: uv run python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1

# Enable only after isolated send and duplicate-prevention acceptance checks.
MAIL_DELIVERY_ENABLED=false
# Vercel Schedules path target uses this exact server-side name (16+ random characters).
CRON_SECRET=
